---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1rem;
    background-color: lightgray;

    overflow-inline: auto;

    li{
      flex: 1 0 400px;
    }
  }
</style>
